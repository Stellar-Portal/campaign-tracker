# Cloudflare Pages: headers for every page and file (GitHub Pages ignores this file).
# Content-Security-Policy: pages may only run our own scripts (plus the one inline redirect stub, by hash: if that
# stub in the HTML <head> changes, update its sha256 here), talk to our Supabase project, show TikTok/YouTube players,
# and load images from https. Inline style attributes are allowed (the app uses them a lot).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-c+Xo1JUAVhtsJv8kcvnv9czrwlC9JjCLO15oplcSlCI='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://vmzbpuootzchpdnvtfhb.supabase.co wss://vmzbpuootzchpdnvtfhb.supabase.co; media-src 'self' blob: https://vmzbpuootzchpdnvtfhb.supabase.co; frame-src https://www.tiktok.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
